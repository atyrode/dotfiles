# A nix-darwin hidutil agent changes only built-in Caps Lock to right Control.
# skhd consumes that modifier; it owns no HID remap or virtual keyboard.

# Window focus.
rctrl - h : yabai -m window --focus west
rctrl - j : yabai -m window --focus south
rctrl - k : yabai -m window --focus north
rctrl - l : yabai -m window --focus east

# Arrow aliases for the same four directions. These are aliases, not a second
# model: the tree has no free-floating windows to snap, so there is no
# equivalent of Windows' Aero Snap. Maximise is zoom-fullscreen on `f`.
rctrl - left : yabai -m window --focus west
rctrl - down : yabai -m window --focus south
rctrl - up : yabai -m window --focus north
rctrl - right : yabai -m window --focus east

# Reinsert the focused window in the BSP tree.
rctrl + shift - h : yabai -m window --warp west
rctrl + shift - j : yabai -m window --warp south
rctrl + shift - k : yabai -m window --warp north
rctrl + shift - l : yabai -m window --warp east
rctrl + shift - left : yabai -m window --warp west
rctrl + shift - down : yabai -m window --warp south
rctrl + shift - up : yabai -m window --warp north
rctrl + shift - right : yabai -m window --warp east

# Focus existing native Spaces.
#
# The number row MUST be addressed by virtual keycode, never by the characters
# "1".."9". skhd.zig resolves a character literal through
# TISCopyCurrentASCIICapableKeyboardLayoutInputSource + UCKeyTranslate, so the
# literal only exists if the active layout produces that character unshifted.
# This workstation runs French AZERTY, whose unshifted number row is
# & é " ' ( § è ! ç à -- no keycode yields "1", so "cmd - 1" aborts the whole
# config with `Unknown key '1'`. Keycodes are layout-independent and give the
# positional, i3-like behavior we actually want.
#
# Carbon kVK_ANSI_<n> constants, verified against Carbon.framework on-device:
#   1 0x12   2 0x13   3 0x14   4 0x15   5 0x17
#   6 0x16   7 0x1A   8 0x1C   9 0x19
#
# Each switch also announces its destination to SketchyBar through the custom
# space_eager event. macOS only emits space_change when the slide animation
# commits, so without this the bar highlight trails the keypress by the whole
# animation. Trackpad swipes have no knowable destination and stay commit-timed.
rctrl - 0x12 : yabai -m space --focus 1 && sketchybar --trigger space_eager TARGET=1
rctrl - 0x13 : yabai -m space --focus 2 && sketchybar --trigger space_eager TARGET=2
rctrl - 0x14 : yabai -m space --focus 3 && sketchybar --trigger space_eager TARGET=3
rctrl - 0x15 : yabai -m space --focus 4 && sketchybar --trigger space_eager TARGET=4
rctrl - 0x17 : yabai -m space --focus 5 && sketchybar --trigger space_eager TARGET=5
rctrl - 0x16 : yabai -m space --focus 6 && sketchybar --trigger space_eager TARGET=6
rctrl - 0x1A : yabai -m space --focus 7 && sketchybar --trigger space_eager TARGET=7
rctrl - 0x1C : yabai -m space --focus 8 && sketchybar --trigger space_eager TARGET=8
rctrl - 0x19 : yabai -m space --focus 9 && sketchybar --trigger space_eager TARGET=9

# Send the focused window to a Space and follow it.
rctrl + shift - 0x12 : yabai -m window --space 1 && yabai -m space --focus 1 && sketchybar --trigger space_eager TARGET=1
rctrl + shift - 0x13 : yabai -m window --space 2 && yabai -m space --focus 2 && sketchybar --trigger space_eager TARGET=2
rctrl + shift - 0x14 : yabai -m window --space 3 && yabai -m space --focus 3 && sketchybar --trigger space_eager TARGET=3
rctrl + shift - 0x15 : yabai -m window --space 4 && yabai -m space --focus 4 && sketchybar --trigger space_eager TARGET=4
rctrl + shift - 0x17 : yabai -m window --space 5 && yabai -m space --focus 5 && sketchybar --trigger space_eager TARGET=5
rctrl + shift - 0x16 : yabai -m window --space 6 && yabai -m space --focus 6 && sketchybar --trigger space_eager TARGET=6
rctrl + shift - 0x1A : yabai -m window --space 7 && yabai -m space --focus 7 && sketchybar --trigger space_eager TARGET=7
rctrl + shift - 0x1C : yabai -m window --space 8 && yabai -m space --focus 8 && sketchybar --trigger space_eager TARGET=8
rctrl + shift - 0x19 : yabai -m window --space 9 && yabai -m space --focus 9 && sketchybar --trigger space_eager TARGET=9

# Layout operations.
rctrl - space : yabai -m window --toggle float
rctrl - f : yabai -m window --toggle zoom-fullscreen
rctrl - b : yabai -m space --balance

# Bracket keycodes, for the same layout-independence reason as the number row.
# kVK_ANSI_LeftBracket 0x21, kVK_ANSI_RightBracket 0x1E.
rctrl - 0x21 : yabai -m display --focus prev
rctrl - 0x1E : yabai -m display --focus next
rctrl + shift - 0x21 : yabai -m window --display prev && yabai -m display --focus prev
rctrl + shift - 0x1E : yabai -m window --display next && yabai -m display --focus next

# Resize mode uses unmodified home-row keys. Shift shrinks the same edge.
:: resize
rctrl - r ; resize
resize < h : yabai -m window --resize left:-40:0
resize < j : yabai -m window --resize bottom:0:40
resize < k : yabai -m window --resize top:0:-40
resize < l : yabai -m window --resize right:40:0
resize < shift - h : yabai -m window --resize left:40:0
resize < shift - j : yabai -m window --resize bottom:0:-40
resize < shift - k : yabai -m window --resize top:0:40
resize < shift - l : yabai -m window --resize right:-40:0
resize < left : yabai -m window --resize left:-40:0
resize < down : yabai -m window --resize bottom:0:40
resize < up : yabai -m window --resize top:0:-40
resize < right : yabai -m window --resize right:40:0
resize < shift - left : yabai -m window --resize left:40:0
resize < shift - down : yabai -m window --resize bottom:0:-40
resize < shift - up : yabai -m window --resize top:0:40
resize < shift - right : yabai -m window --resize right:-40:0
resize < escape ; default
resize < return ; default
resize < rctrl - r ; default
