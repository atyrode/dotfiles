# Window focus. Caps Lock is the ctrl+alt+cmd leader; the physical modifiers
# still work if Karabiner is ever disabled.
ctrl + alt + cmd - h : yabai -m window --focus west
ctrl + alt + cmd - j : yabai -m window --focus south
ctrl + alt + cmd - k : yabai -m window --focus north
ctrl + alt + cmd - l : yabai -m window --focus east

# Arrow aliases for the same four directions. These are aliases, not a second
# model: the tree has no free-floating windows to snap, so there is no
# equivalent of Windows' Aero Snap. Maximise is zoom-fullscreen on `f`.
ctrl + alt + cmd - left : yabai -m window --focus west
ctrl + alt + cmd - down : yabai -m window --focus south
ctrl + alt + cmd - up : yabai -m window --focus north
ctrl + alt + cmd - right : yabai -m window --focus east

# Reinsert the focused window in the BSP tree.
ctrl + alt + cmd + shift - h : yabai -m window --warp west
ctrl + alt + cmd + shift - j : yabai -m window --warp south
ctrl + alt + cmd + shift - k : yabai -m window --warp north
ctrl + alt + cmd + shift - l : yabai -m window --warp east
ctrl + alt + cmd + shift - left : yabai -m window --warp west
ctrl + alt + cmd + shift - down : yabai -m window --warp south
ctrl + alt + cmd + shift - up : yabai -m window --warp north
ctrl + alt + cmd + shift - right : yabai -m window --warp east

# Focus existing native Spaces.
#
# The number row MUST be addressed by virtual keycode, never by the characters
# "1".."9". skhd.zig resolves a character literal through
# TISCopyCurrentASCIICapableKeyboardLayoutInputSource + UCKeyTranslate, so the
# literal only exists if the active layout produces that character unshifted.
# This workstation runs French AZERTY, whose unshifted number row is
# & é " ' ( § è ! ç à -- no keycode yields "1", so "cmd - 1" aborts the whole
# config with `Unknown key '1'`. Keycodes are layout-independent and give the
# positional, i3-like behavior we actually want.
#
# Carbon kVK_ANSI_<n> constants, verified against Carbon.framework on-device:
#   1 0x12   2 0x13   3 0x14   4 0x15   5 0x17
#   6 0x16   7 0x1A   8 0x1C   9 0x19
#
# Each switch also announces its destination to SketchyBar through the custom
# space_eager event. macOS only emits space_change when the slide animation
# commits, so without this the bar highlight trails the keypress by the whole
# animation. Trackpad swipes have no knowable destination and stay commit-timed.
ctrl + alt + cmd - 0x12 : yabai -m space --focus 1 && sketchybar --trigger space_eager TARGET=1
ctrl + alt + cmd - 0x13 : yabai -m space --focus 2 && sketchybar --trigger space_eager TARGET=2
ctrl + alt + cmd - 0x14 : yabai -m space --focus 3 && sketchybar --trigger space_eager TARGET=3
ctrl + alt + cmd - 0x15 : yabai -m space --focus 4 && sketchybar --trigger space_eager TARGET=4
ctrl + alt + cmd - 0x17 : yabai -m space --focus 5 && sketchybar --trigger space_eager TARGET=5
ctrl + alt + cmd - 0x16 : yabai -m space --focus 6 && sketchybar --trigger space_eager TARGET=6
ctrl + alt + cmd - 0x1A : yabai -m space --focus 7 && sketchybar --trigger space_eager TARGET=7
ctrl + alt + cmd - 0x1C : yabai -m space --focus 8 && sketchybar --trigger space_eager TARGET=8
ctrl + alt + cmd - 0x19 : yabai -m space --focus 9 && sketchybar --trigger space_eager TARGET=9

# Send the focused window to a Space and follow it.
ctrl + alt + cmd + shift - 0x12 : yabai -m window --space 1 && yabai -m space --focus 1 && sketchybar --trigger space_eager TARGET=1
ctrl + alt + cmd + shift - 0x13 : yabai -m window --space 2 && yabai -m space --focus 2 && sketchybar --trigger space_eager TARGET=2
ctrl + alt + cmd + shift - 0x14 : yabai -m window --space 3 && yabai -m space --focus 3 && sketchybar --trigger space_eager TARGET=3
ctrl + alt + cmd + shift - 0x15 : yabai -m window --space 4 && yabai -m space --focus 4 && sketchybar --trigger space_eager TARGET=4
ctrl + alt + cmd + shift - 0x17 : yabai -m window --space 5 && yabai -m space --focus 5 && sketchybar --trigger space_eager TARGET=5
ctrl + alt + cmd + shift - 0x16 : yabai -m window --space 6 && yabai -m space --focus 6 && sketchybar --trigger space_eager TARGET=6
ctrl + alt + cmd + shift - 0x1A : yabai -m window --space 7 && yabai -m space --focus 7 && sketchybar --trigger space_eager TARGET=7
ctrl + alt + cmd + shift - 0x1C : yabai -m window --space 8 && yabai -m space --focus 8 && sketchybar --trigger space_eager TARGET=8
ctrl + alt + cmd + shift - 0x19 : yabai -m window --space 9 && yabai -m space --focus 9 && sketchybar --trigger space_eager TARGET=9

# Layout operations.
ctrl + alt + cmd - space : yabai -m window --toggle float
ctrl + alt + cmd - f : yabai -m window --toggle zoom-fullscreen
ctrl + alt + cmd - b : yabai -m space --balance

# Bracket keycodes, for the same layout-independence reason as the number row.
# kVK_ANSI_LeftBracket 0x21, kVK_ANSI_RightBracket 0x1E.
ctrl + alt + cmd - 0x21 : yabai -m display --focus prev
ctrl + alt + cmd - 0x1E : yabai -m display --focus next
ctrl + alt + cmd + shift - 0x21 : yabai -m window --display prev && yabai -m display --focus prev
ctrl + alt + cmd + shift - 0x1E : yabai -m window --display next && yabai -m display --focus next

# Resize mode uses unmodified home-row keys. Shift shrinks the same edge.
:: resize
ctrl + alt + cmd - r ; resize
resize < h : yabai -m window --resize left:-40:0
resize < j : yabai -m window --resize bottom:0:40
resize < k : yabai -m window --resize top:0:-40
resize < l : yabai -m window --resize right:40:0
resize < shift - h : yabai -m window --resize left:40:0
resize < shift - j : yabai -m window --resize bottom:0:-40
resize < shift - k : yabai -m window --resize top:0:40
resize < shift - l : yabai -m window --resize right:-40:0
resize < left : yabai -m window --resize left:-40:0
resize < down : yabai -m window --resize bottom:0:40
resize < up : yabai -m window --resize top:0:-40
resize < right : yabai -m window --resize right:40:0
resize < shift - left : yabai -m window --resize left:40:0
resize < shift - down : yabai -m window --resize bottom:0:-40
resize < shift - up : yabai -m window --resize top:0:40
resize < shift - right : yabai -m window --resize right:-40:0
resize < escape ; default
resize < return ; default
resize < ctrl + alt + cmd - r ; default
