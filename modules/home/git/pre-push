#!/usr/bin/env bash
set -euo pipefail

remote_name=${1:-}
remote_url=${2:-}

# The ref list arrives on stdin once; it is kept so the repository's own hook
# can read it too. A global hooks path hides local hooks from git, so this
# hook runs the local one itself, on every path out, when a project installs
# one.
refs="$(cat)"
chain_local_hook() {
  local local_hook
  local_hook="$(git rev-parse --git-dir)/hooks/pre-push"
  if [[ -x "$local_hook" ]]; then
    printf '%s\n' "$refs" | "$local_hook" "$@"
  fi
}

# Other hosts may intentionally use a different identity (for example, the
# managed GitLab include). Enforce Alex's identity on every GitHub push.
case "$remote_url" in
  git@github.com:* | ssh://git@github.com/* | https://github.com/* | https://*@github.com/*) ;;
  *)
    chain_local_hook "$@"
    exit 0
    ;;
esac

expected_name="Alex TYRODE"
expected_email="alex@tyrode.dev"
failed=0

while read -r local_ref local_oid remote_ref remote_oid; do
  [[ -n "$local_ref" ]] || continue
  # A zero local object ID is a ref deletion and introduces no commits.
  if [[ ! "$local_oid" =~ [^0] ]]; then
    continue
  fi

  if [[ ! "$remote_oid" =~ [^0] ]]; then
    # For a newly created ref, check commits that are not already present on a
    # tracked remote ref. This avoids rejecting reviewed history that this push
    # merely uses as its base.
    mapfile -t commits < <(git rev-list "$local_oid" --not --remotes)
  else
    # Same exclusion for existing refs: a rebase onto a reviewed remote branch
    # must not re-flag that branch's GitHub-committed merge history.
    mapfile -t commits < <(git rev-list "$remote_oid..$local_oid" --not --remotes)
  fi

  for commit in "${commits[@]}"; do
    author_name=$(git show -s --format=%an "$commit")
    author_email=$(git show -s --format=%ae "$commit")
    committer_name=$(git show -s --format=%cn "$commit")
    committer_email=$(git show -s --format=%ce "$commit")

    if [[ "$author_name" != "$expected_name" || "$author_email" != "$expected_email" ||
          "$committer_name" != "$expected_name" || "$committer_email" != "$expected_email" ]]; then
      printf >&2 'Rejected GitHub push: commit %s has unapproved identity.\n' "$commit"
      printf >&2 '  author:    %s <%s>\n' "$author_name" "$author_email"
      printf >&2 '  committer: %s <%s>\n' "$committer_name" "$committer_email"
      printf >&2 '  required:  %s <%s>\n' "$expected_name" "$expected_email"
      failed=1
      continue
    fi

    if ! git verify-commit "$commit" >/dev/null 2>&1; then
      printf >&2 'Rejected GitHub push: commit %s is not signed by an approved SSH signing key.\n' "$commit"
      failed=1
    fi
  done
done <<<"$refs"

if ((failed)); then
  printf >&2 'Push blocked before any GitHub ref was updated.\n'
  exit 1
fi

chain_local_hook "$@"
