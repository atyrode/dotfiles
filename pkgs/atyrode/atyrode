#!@shell@
# shellcheck shell=bash disable=SC1008,SC2239
# Module sources below resolve against this file's own directory, so the CLI
# lints identically from the repository root and from pkgs/atyrode.
# shellcheck source-path=SCRIPTDIR
set -euo pipefail
# Without inherit_errexit, bash unsets errexit inside every $(...) subshell.
# This script is written for errexit - its command substitutions are unguarded
# and `die` is expected to stop the program - so a `die` reached inside a
# substitution would only end that subshell, handing the caller an empty string
# and letting it carry on past the failure.
shopt -s inherit_errexit

