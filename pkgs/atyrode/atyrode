# directory. Environment variables cannot bypass supervised activation.
apply_job_worker=0

# The CLI is one command made of modules, not one file. Each module owns a
# domain and is sourced before anything runs, so definition order never
# matters; only the substitutions above do, and they all live here so a module
# never has to be rewritten at build time.
#
# Spelled out one line at a time rather than looped: a loop reads better and
# checks worse. ShellCheck cannot follow a computed source, so it would see
# every global above as unused and every function below as undefined, which is
# the entire class of mistake it is here to catch.
# narrate.sh first: it is the one module the ceremonies also source, so the CLI
