#!@python3@
"""Read-only readiness: Clan checks sources; the filesystem checks placement."""

import argparse
import grp
import json
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import sys


def inspect_path(path):
    try:
        resolved = Path(path).resolve(strict=True)
        if not os.access(resolved, os.R_OK):
            return "permission-unknown", str(resolved)
        return "ok", str(resolved)
    except FileNotFoundError:
        try:
            return "absent", str(Path(path).resolve(strict=False))
        except (OSError, RuntimeError):
            return "inspection-unavailable", str(path)
    except (OSError, RuntimeError):
        return "inspection-unavailable", str(path)


def input_metadata(path):
    try:
        resolved = Path(path).resolve(strict=True)
        return resolved, resolved.stat()
    except PermissionError:
        # Like machine_key_placed, escalate only denied metadata inspection,
        # never prompt or turn unavailable authorization into absence. -I
        # keeps caller-controlled Python startup code out of the root probe.
        script = (
            "import json,os,sys\n"
            "from pathlib import Path\n"
            "try:\n"
            " p=Path(sys.argv[1]).resolve(strict=True)\n"
            " print(json.dumps([str(p),list(p.stat())]))\n"
            "except FileNotFoundError: sys.exit(3)\n"
            "except NotADirectoryError: sys.exit(4)\n"
            "except (OSError,RuntimeError): sys.exit(2)\n"
        )
        try:
            result = subprocess.run(
                ["sudo", "-n", sys.executable, "-I", "-c", script, path],
                capture_output=True, text=True, timeout=10, check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise PermissionError from error
        if result.returncode == 3:
            raise FileNotFoundError
        if result.returncode == 4:
            raise NotADirectoryError
        if result.returncode != 0:
            raise PermissionError
        try:
            target, metadata = json.loads(result.stdout)
            return Path(target), os.stat_result(metadata)
        except (ValueError, TypeError) as error:
            raise PermissionError from error


def inspect_input(file):
    path = file["path"]
    access = file["access"]
    if access is None:
        state, target = inspect_path(path)
        if state == "ok" and not Path(target).is_file():
            state = "placement-required"
        return state, target
    target = path
    try:
        resolved, metadata = input_metadata(path)
        target = str(resolved)
        owner = access["owner"]
        group = access["group"]
        uid = int(owner) if owner.isdecimal() else pwd.getpwnam(owner).pw_uid
        gid = int(group) if group.isdecimal() else grp.getgrnam(group).gr_gid
        mode = int(access["mode"], 8)
        # Clan's owner is the consumer (including root loading service
        # credentials). Operator readability would reject correct private keys.
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != uid
            or metadata.st_gid != gid
            or stat.S_IMODE(metadata.st_mode) != mode
            or not mode & stat.S_IRUSR
        ):
            return "placement-required", target
        if uid != 0:
            account = pwd.getpwuid(uid)
            groups = os.getgrouplist(account.pw_name, account.pw_gid)
            # Check both the declared route and the resolved route: sops-nix
            # uses generation symlinks, and Darwin also aliases /var.
            for parent in (*Path(path).parents, *resolved.parents):
                directory = parent.stat()
                bit = (
                    stat.S_IXUSR if directory.st_uid == uid
                    else stat.S_IXGRP if directory.st_gid in groups
                    else stat.S_IXOTH
                )
                if not directory.st_mode & bit:
                    return "permission-unknown", target
        return "ok", target
    except FileNotFoundError:
        try:
            return "absent", str(Path(path).resolve(strict=False))
        except (OSError, RuntimeError):
            return "absent", target
    except NotADirectoryError:
        return "placement-required", target
    except (OSError, RuntimeError, KeyError):
        return "inspection-unavailable", target


def validate_manifest(manifest):
    if manifest["schemaVersion"] != 2:
        raise ValueError("unsupported manifest")
    for value in (manifest["host"], manifest["flake"]):
        if not isinstance(value, str) or not value:
            raise ValueError("invalid source metadata")
    if not isinstance(manifest["generators"], list) or not isinstance(manifest["links"], list):
        raise ValueError("invalid declarations")
    for generator in manifest["generators"]:
        if not isinstance(generator["name"], str) or not generator["name"]:
            raise ValueError("invalid generator")
        if not isinstance(generator["files"], list):
            raise ValueError("invalid files")
        for file in generator["files"]:
            if not isinstance(file["name"], str) or not file["name"]:
                raise ValueError("invalid file")
            if file["path"] is not None and (
                not isinstance(file["path"], str) or not file["path"].startswith("/")
            ):
                raise ValueError("invalid deployed path")
            access = file["access"]
            if access is not None:
                if any(not isinstance(access[key], str) or not access[key] for key in ("owner", "group")):
                    raise ValueError("invalid consumer")
                if not isinstance(access["mode"], str) or not re.fullmatch(r"[0-7]{4}", access["mode"]):
                    raise ValueError("invalid mode")
    for file in manifest["links"]:
        if any(not isinstance(file[key], str) or not file[key].startswith("/") for key in ("source", "link")):
            raise ValueError("invalid managed link")


def source_findings(manifest, clan, flake):
    # check_vars calls vars_status, including store health and invalidation.
    # Its diagnostic prose is not forwarded: only declared names may escape.
    if not manifest["generators"]:
        return []
    try:
        result = subprocess.run(
            [clan, "vars", "check", manifest["host"], "--flake", flake],
            capture_output=True, text=True, timeout=120, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return [{"code": "inspection-unavailable", "subject": "clan vars check"}]
    if result.returncode == 0:
        return []
    output = result.stdout + result.stderr
    findings = []
    for generator in manifest["generators"]:
        name = generator["name"]
        for file in generator["files"]:
            # Match the maintained check's named missing-file diagnostic, not
            # exit 1: evaluation and permission failures can also exit 1.
            pattern = (
                rf"(?:Secret|Public) var '{re.escape(file['name'])}' for service "
                rf"'{re.escape(name)}' in machine {re.escape(manifest['host'])} is missing\."
            )
            if re.search(pattern, output):
                findings.append({"code": "generation-required", "subject": f"{name}/{file['name']}"})
        if f"Generator '{name}' in machine {manifest['host']} has outdated invalidation hash." in output:
            findings.append({"code": "generation-required", "subject": name})
    return findings or [{"code": "inspection-unavailable", "subject": "clan vars check (source health or access unresolved)"}]


def readiness(manifest, clan, flake=None, sources_only=False):
    validate_manifest(manifest)
    findings = source_findings(manifest, clan, flake or manifest["flake"])
    if not sources_only:
        for generator in manifest["generators"]:
            for file in generator["files"]:
                path = file["path"]
                if path is None:
                    continue
                subject = f"{generator['name']}/{file['name']}"
                if path == "/no-such-path":
                    findings.append({"code": "generation-required", "subject": subject})
                    continue
                state, target = inspect_input(file)
                if state != "ok":
                    findings.append({"code": state, "subject": subject, "path": path, "target": target})
        for file in manifest["links"]:
            # Home Manager's source is itself a store symlink for an
            # out-of-store file. Inspect it even when activation never placed
            # the home link. Ordinary store-backed files need no extra probe.
            source_state, target = inspect_path(file["source"])
            if source_state == "ok" and target.startswith("/nix/store/"):
                continue
            state, placed_target = inspect_path(file["link"])
            if source_state != "ok" or state != "ok" or target != placed_target:
                findings.append({
                    "code": source_state if source_state != "ok" else state if state != "ok" else "placement-required",
                    "subject": "managed link", "path": file["link"], "target": target,
                })
    return {"ready": not findings, "findings": findings}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("manifest")
    parser.add_argument("--clan", default="clan")
    parser.add_argument("--flake")
    parser.add_argument("--sources-only", action="store_true")
    args = parser.parse_args()
    try:
        with open(args.manifest) as stream:
            manifest = json.load(stream)
        result = readiness(manifest, args.clan, args.flake, args.sources_only)
    except (OSError, ValueError, KeyError, TypeError):
        result = {"ready": False, "findings": [{"code": "inspection-unavailable", "subject": "declared input metadata"}]}
    print(json.dumps(result))
    return 0 if result["ready"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
