#!@shell@
# shellcheck shell=bash
set -euo pipefail

readonly EX_USAGE=64 EX_DATAERR=65 EX_NOINPUT=66 EX_UNAVAILABLE=69 EX_SOFTWARE=70
readonly capability_name="local-qwen"
readonly source_url="https://github.com/syv-ai/qwen38-27b-rtx3090.git"
readonly source_revision="51905d1902e699e35e4c11cb0eb9ffe230a11344"
readonly model_id="qwen3.8-27b"
readonly context_window=150000
readonly max_output_tokens=32768
readonly compaction_reserve_tokens=40000
readonly estimated_disk_bytes=40000000000
readonly omp_managed='@omp_managed@'

config_root="${XDG_CONFIG_HOME:-$HOME/.config}/atyrode/runtime"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/atyrode/runtime/$capability_name"
config_file="$config_root/$capability_name.env"
compose_override="$state_root/compose.override.yml"
prepared_marker="$state_root/prepared"

die() {
  local code="$1"
  shift
  printf 'atyrode: %s\n' "$*" >&2
  exit "$code"
}

usage() {
  cat <<'EOF'
Usage:
  atyrode runtime list [--json]
  atyrode runtime status [local-qwen] [--json]
  atyrode runtime provision [local-qwen] [--data-dir PATH] [--yes]
  atyrode runtime start|stop|run [local-qwen]
  atyrode runtime autostart [local-qwen] on|off
  atyrode runtime boot
  atyrode runtime shortcut [local-qwen]

Runtime capabilities are installed per machine and outside the Nix store.
The local-qwen capability adopts ~/qwen-serving when possible. Otherwise its
first explicit provision asks before cloning, building, and downloading about
40 GB. `run` starts the API, waits for health, and opens managed OMP with an
isolated local-qwen profile.
EOF
}

require_capability() {
  [[ "${1:-$capability_name}" == "$capability_name" ]] ||
    die "$EX_USAGE" "unknown runtime capability: ${1:-}"
}

applicable() {
  [[ "$(uname -s)" == Linux && "$(uname -m)" == x86_64 &&
    -n "${WSL_DISTRO_NAME:-}" && -e /dev/dxg &&
    -e /usr/lib/wsl/lib/libcuda.so.1 ]]
}

require_applicable() {
  applicable || die "$EX_UNAVAILABLE" \
    "local-qwen requires x86_64 WSL2 with NVIDIA CUDA GPU passthrough"
}

load_config() {
  DATA_DIR=""
  AUTOSTART=0
  if [[ -f "$config_file" ]]; then
    # The file is generated by this command and contains only quoted values.
    # shellcheck disable=SC1090
    source "$config_file"
  fi
}

write_config() {
  local data_dir="$1" autostart="$2" tmp
  mkdir -p "$config_root"
  tmp="$(mktemp "$config_root/.local-qwen.XXXXXX")"
  printf 'DATA_DIR=%q\nAUTOSTART=%q\n' "$data_dir" "$autostart" >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$config_file"
  DATA_DIR="$data_dir"
  AUTOSTART="$autostart"
}

env_value() {
  local key="$1" file="$2"
  awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$file"
}

env_set_default() {
  local file="$1" key="$2" value="$3"
  grep -q "^${key}=" "$file" 2>/dev/null || printf '%s=%s\n' "$key" "$value" >>"$file"
}

env_append_default_arg() {
  local file="$1" key="$2" option="$3" value="$4" current tmp
  current="$(env_value "$key" "$file")"
  [[ "$current" =~ (^|[[:space:]])${option}([=[:space:]]|$) ]] && return
  tmp="$(mktemp "${file}.XXXXXX")"
  awk -F= -v key="$key" -v suffix="$option $value" '
    $1 == key { print $0 " " suffix; found = 1; next }
    { print }
    END { if (!found) print key "=" suffix }
  ' "$file" >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$file"
}

compose() {
  docker compose --project-directory "$DATA_DIR" \
    -f "$DATA_DIR/docker-compose.yml" -f "$compose_override" "$@"
}

resolve_data_dir() {
  local requested="${1:-}"
  load_config
  if [[ -n "$requested" ]]; then
    [[ "$requested" == /* ]] || die "$EX_USAGE" "--data-dir expects an absolute Linux path"
    DATA_DIR="${requested%/}"
  elif [[ -n "$DATA_DIR" ]]; then
    :
  elif [[ -d "$HOME/qwen-serving/.git" ]]; then
    DATA_DIR="$HOME/qwen-serving"
  else
    DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/atyrode/runtime/$capability_name/repo"
  fi
}

write_override() {
  mkdir -p "$state_root"
  cat >"$compose_override" <<'EOF'
services:
  single:
    ports: !override
      - "127.0.0.1:${PORT:-18020}:${PORT:-18020}"
    deploy:
      resources:
        reservations:
          devices: !reset []
    devices: !override
      - nvidia.com/gpu=all
EOF
  chmod 600 "$compose_override"
}

ensure_env() {
  local env_file="$DATA_DIR/.env"
  if [[ ! -e "$env_file" ]]; then
    umask 077
    printf 'VLLM_API_KEY=%s\n' "$(openssl rand -hex 24)" >"$env_file"
  fi
  chmod 600 "$env_file"
  env_set_default "$env_file" CTX long
  env_set_default "$env_file" SPEC mtp
  env_set_default "$env_file" PREFIX_CACHE 1
  env_set_default "$env_file" GPU_UTIL 0.93
  env_set_default "$env_file" PYTORCH_CUDA_ALLOC_CONF expandable_segments:False
  env_set_default "$env_file" HF_HUB_DISABLE_XET 1
  env_set_default "$env_file" PORT 18020
  env_set_default "$env_file" EXTRA_ARGS "--enable-auto-tool-choice --tool-call-parser qwen3_coder --max-num-batched-tokens 1024"
  # The pinned syv-ai launcher uses 2048 for maximum benchmark throughput.
  # Its EXTRA_ARGS are appended last, so this smaller prompt/prefill quantum
  # improves desktop responsiveness when the same WSL GPU drives Windows.
  # Append it to installations created before this default was introduced,
  # while preserving an explicit machine-local value when one already exists.
  env_append_default_arg "$env_file" EXTRA_ARGS --max-num-batched-tokens 1024
  [[ -n "$(env_value VLLM_API_KEY "$env_file")" ]] ||
    die "$EX_DATAERR" "$env_file has no VLLM_API_KEY"
}

provisioned() {
  [[ -n "${DATA_DIR:-}" && -f "$DATA_DIR/docker-compose.yml" && -f "$DATA_DIR/.env" ]]
}

healthy() {
  local port="${1:-18020}"
  curl --silent --fail --max-time 2 "http://127.0.0.1:$port/health" >/dev/null 2>&1
}

status_json() {
  load_config
  local adopted=false provisioned_state=false running=false healthy_state=false applicable_state=false
  local data_dir="$DATA_DIR" port=18020 disk_bytes=0 phase=unsupported reason=""
  if applicable; then
    applicable_state=true
    phase=available
  else
    reason="requires x86_64 WSL2 with NVIDIA CUDA GPU passthrough"
  fi
  if [[ -z "$data_dir" && -d "$HOME/qwen-serving/.git" ]]; then
    data_dir="$HOME/qwen-serving"
    adopted=true
  fi
  if [[ -n "$data_dir" && -f "$data_dir/docker-compose.yml" ]]; then
    [[ -f "$data_dir/.env" ]] && port="$(env_value PORT "$data_dir/.env")"
    port="${port:-18020}"
    provisioned_state=true
    if [[ "$applicable_state" == true ]]; then phase=provisioned; fi
    disk_bytes="$(du -sb "$data_dir" 2>/dev/null | awk '{print $1}' || printf 0)"
    if healthy "$port"; then
      running=true
      healthy_state=true
      if [[ "$applicable_state" == true ]]; then phase=ready; fi
    elif command -v docker >/dev/null 2>&1 && [[ -f "$compose_override" && -f "$config_file" ]]; then
      if DATA_DIR="$data_dir" compose ps --status running --quiet single 2>/dev/null | grep -q .; then
        running=true
        if [[ "$applicable_state" == true ]]; then phase=starting; fi
      fi
    fi
  fi
  jq -nc \
    --arg name "$capability_name" --arg label "Local Qwen 3.8 27B" \
    --arg phase "$phase" --arg reason "$reason" --arg dataDir "$data_dir" \
    --arg endpoint "http://127.0.0.1:$port/v1" --arg model "$model_id" \
    --arg sourceRevision "$source_revision" --argjson contextWindow "$context_window" \
    --argjson applicable "$applicable_state" --argjson provisioned "$provisioned_state" \
    --argjson adopted "$adopted" --argjson estimatedDiskBytes "$estimated_disk_bytes" \
    --argjson running "$running" --argjson healthy "$healthy_state" \
    --argjson autostart "$([[ "$AUTOSTART" == 1 ]] && printf true || printf false)" \
    --argjson diskBytes "${disk_bytes:-0}" \
    '{schemaVersion:1,name:$name,label:$label,phase:$phase,reason:$reason,
      applicable:$applicable,provisioned:$provisioned,adoptable:$adopted,
      running:$running,healthy:$healthy,autostart:$autostart,dataDir:$dataDir,
      diskBytes:$diskBytes,estimatedDiskBytes:$estimatedDiskBytes,
      endpoint:$endpoint,model:$model,contextWindow:$contextWindow,
      sourceRevision:$sourceRevision}'
}

render_status() {
  status_json | jq -r '
    "local-qwen: \(.phase)",
    "  model: \(.model) (\(.contextWindow) context)",
    "  API: \(.endpoint)",
    "  storage: \(if .dataDir == "" then "not allocated" else .dataDir end)",
    "  autostart: \(.autostart)"'
}

cmd_provision() {
  local requested="$capability_name" data_dir="" yes=0
  if [[ $# -gt 0 && "$1" != --* ]]; then requested="$1"; shift; fi
  require_capability "$requested"
  require_applicable
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --data-dir) shift; [[ -n "${1:-}" ]] || die "$EX_USAGE" "--data-dir expects a path"; data_dir="$1" ;;
      --yes) yes=1 ;;
      *) die "$EX_USAGE" "unknown runtime provision option: $1" ;;
    esac
    shift
  done
  resolve_data_dir "$data_dir"
  command -v docker >/dev/null || die "$EX_UNAVAILABLE" "Docker is required"
  docker compose version >/dev/null || die "$EX_UNAVAILABLE" "Docker Compose is required"
  command -v git >/dev/null || die "$EX_UNAVAILABLE" "Git is required"
  command -v openssl >/dev/null || die "$EX_UNAVAILABLE" "OpenSSL is required"

  if [[ -d "$DATA_DIR/.git" ]]; then
    local remote revision
    remote="$(git -C "$DATA_DIR" remote get-url origin 2>/dev/null || true)"
    revision="$(git -C "$DATA_DIR" rev-parse HEAD 2>/dev/null || true)"
    [[ "$remote" == "$source_url" || "$remote" == "${source_url%.git}" ]] ||
      die "$EX_DATAERR" "$DATA_DIR is not the syv-ai local-qwen repository"
    [[ "$revision" == "$source_revision" ]] ||
      die "$EX_DATAERR" "$DATA_DIR is at $revision; expected pinned revision $source_revision"
    printf 'atyrode: adopting existing local-qwen data at %s\n' "$DATA_DIR" >&2
  else
    if [[ "$yes" != 1 ]]; then
      [[ -t 0 ]] || die "$EX_USAGE" "provisioning needs confirmation; rerun with --yes"
      printf 'Provision local-qwen at %s? This builds an image and downloads about 40 GB. [y/N] ' "$DATA_DIR" >&2
      read -r answer
      if [[ "$answer" != y && "$answer" != Y ]]; then
        printf 'atyrode: local-qwen was not provisioned\n' >&2
        exit 0
      fi
    fi
    mkdir -p "$(dirname "$DATA_DIR")"
    git clone --filter=blob:none --no-checkout "$source_url" "$DATA_DIR"
    git -C "$DATA_DIR" fetch --depth 1 origin "$source_revision"
    git -C "$DATA_DIR" checkout --detach "$source_revision"
  fi

  write_config "$DATA_DIR" "${AUTOSTART:-0}"
  write_override
  ensure_env
  printf 'atyrode: preparing image and model data (idempotent; this can take a while)\n' >&2
  compose run --rm prepare
  mkdir -p "$state_root"
  : >"$prepared_marker"
  render_status
}

ensure_provisioned() {
  require_applicable
  resolve_data_dir ""
  if ! provisioned; then
    cmd_provision "$capability_name"
    resolve_data_dir ""
  elif [[ ! -f "$config_file" ]]; then
    # `run` is itself an explicit request. Persist an already-complete
    # installation as this machine's selected data path without rerunning the
    # idempotent (but potentially lengthy) prepare job.
    write_config "$DATA_DIR" "${AUTOSTART:-0}"
  fi
  write_override
  ensure_env
  if [[ ! -f "$prepared_marker" ]]; then
    printf 'atyrode: verifying local-qwen image and model data (idempotent)\n' >&2
    compose run --rm prepare
    : >"$prepared_marker"
  fi
}

wait_healthy() {
  local port deadline
  port="$(env_value PORT "$DATA_DIR/.env")"
  port="${port:-18020}"
  deadline=$((SECONDS + 900))
  until healthy "$port"; do
    if (( SECONDS >= deadline )); then
      compose logs --tail 80 single >&2 || true
      die "$EX_UNAVAILABLE" "local-qwen did not become healthy within 15 minutes"
    fi
    printf 'atyrode: waiting for local-qwen on port %s…\n' "$port" >&2
    sleep 5
  done
  printf 'atyrode: local-qwen is ready at http://127.0.0.1:%s/v1\n' "$port" >&2
}

cmd_start() {
  ensure_provisioned
  compose --profile single up -d --no-deps single
  wait_healthy
  if [[ "${AUTOSTART:-0}" != 1 ]]; then
    local container
    container="$(compose ps --quiet single)"
    [[ -z "$container" ]] || docker update --restart no "$container" >/dev/null
  fi
}

write_omp_profile() {
  local profile_root="$HOME/.omp/profiles/local-qwen/agent" port local_model
  port="$(env_value PORT "$DATA_DIR/.env")"
  port="${port:-18020}"
  mkdir -p "$profile_root"
  local_model="local-qwen/$model_id"
  cat >"$profile_root/models.yml" <<EOF
providers:
  local-qwen:
    baseUrl: http://127.0.0.1:${port}/v1
    api: openai-completions
    apiKey: LOCAL_QWEN_API_KEY
    authHeader: true
    models:
      - id: ${model_id}
        name: Qwen3.8 27B local (RTX 3090)
        contextWindow: ${context_window}
        maxTokens: ${max_output_tokens}
        reasoning: true
EOF
  chmod 600 "$profile_root/models.yml"
  cat >"$profile_root/local-only.yml" <<EOF
modelRoles:
  default: ${local_model}
  smol: ${local_model}
  slow: ${local_model}
  plan: ${local_model}
  task: ${local_model}
  reviewer: ${local_model}
  sonic: ${local_model}
  designer: ${local_model}
  librarian: ${local_model}
  scout: ${local_model}
  tiny: ${local_model}
  commit: ${local_model}
  vision: ${local_model}
retry:
  enabled: true
  modelFallback: false
  fallbackChains: {}
task:
  agentModelOverrides:
    task: ${local_model}
    reviewer: ${local_model}
    sonic: ${local_model}
    designer: ${local_model}
    librarian: ${local_model}
    scout: ${local_model}
advisor:
  enabled: false
compaction:
  enabled: true
  methodOrder:
    - soft
  midTurnEnabled: true
  asyncEnabled: true
  reserveTokens: ${compaction_reserve_tokens}
  keepRecentTokens: 20000
  autoContinue: true
EOF
  chmod 600 "$profile_root/local-only.yml"
}

cmd_run() {
  cmd_start
  write_omp_profile
  [[ "${1:-}" != -- ]] || shift
  export LOCAL_QWEN_API_KEY
  LOCAL_QWEN_API_KEY="$(env_value VLLM_API_KEY "$DATA_DIR/.env")"
  export OMP_SKIP_SETUP=1
  unset OMP_AUTH_BROKER_URL OMP_AUTH_BROKER_TOKEN OMP_AUTH_BROKER_SNAPSHOT_CACHE
  unset PI_AUTH_BROKER_URL PI_AUTH_BROKER_TOKEN PI_AUTH_BROKER_SNAPSHOT_CACHE
  exec "$omp_managed" --profile local-qwen \
    --config "$HOME/.omp/profiles/local-qwen/agent/local-only.yml" \
    --model "local-qwen/$model_id" "$@"
}

cmd_stop() {
  resolve_data_dir ""
  provisioned || die "$EX_NOINPUT" "local-qwen is not provisioned on this machine"
  [[ -f "$compose_override" ]] || write_override
  compose stop single
}

cmd_autostart() {
  local requested="$capability_name" mode="${2:-}"
  if [[ $# -gt 0 && "$1" != on && "$1" != off ]]; then requested="$1"; shift; fi
  mode="${1:-}"
  require_capability "$requested"
  [[ "$mode" == on || "$mode" == off ]] || die "$EX_USAGE" "autostart expects on or off"
  resolve_data_dir ""
  provisioned || die "$EX_NOINPUT" "provision local-qwen before changing autostart"
  write_config "$DATA_DIR" "$([[ "$mode" == on ]] && printf 1 || printf 0)"
  write_override
  local container
  container="$(compose ps --quiet single 2>/dev/null || true)"
  if [[ "$mode" == on ]]; then
    cmd_start
    container="$(compose ps --quiet single)"
    [[ -z "$container" ]] || docker update --restart unless-stopped "$container" >/dev/null
  elif [[ -n "$container" ]]; then
    docker update --restart no "$container" >/dev/null
  fi
  render_status
}

cmd_boot() {
  load_config
  [[ "$AUTOSTART" == 1 ]] || return 0
  cmd_start
}

cmd_shortcut() {
  require_capability "${1:-}"
  [[ -n "${WSL_DISTRO_NAME:-}" ]] ||
    die "$EX_UNAVAILABLE" "shortcut creation requires WSL"
  command -v powershell.exe >/dev/null ||
    die "$EX_UNAVAILABLE" "Windows PowerShell interop is unavailable"
  command -v wslpath >/dev/null || die "$EX_UNAVAILABLE" "wslpath is unavailable"
  local desktop_windows desktop_linux shortcut
  desktop_windows="$(powershell.exe -NoProfile -NonInteractive -Command \
    '[Environment]::GetFolderPath("Desktop")' | tr -d '\r')"
  [[ -n "$desktop_windows" ]] || die "$EX_UNAVAILABLE" "could not locate the Windows desktop"
  desktop_linux="$(wslpath "$desktop_windows")"
  shortcut="$desktop_linux/Local Qwen OMP.cmd"
  cat >"$shortcut" <<EOF
@echo off
where.exe wt.exe >nul 2>&1
if %ERRORLEVEL% EQU 0 (
  start "" wt.exe new-tab --title "Local Qwen OMP" wsl.exe -d "${WSL_DISTRO_NAME}" --cd "~" -- atyrode runtime run local-qwen
) else (
  start "" wsl.exe -d "${WSL_DISTRO_NAME}" --cd "~" -- atyrode runtime run local-qwen
)
EOF
  printf 'atyrode: created %s\n' "$shortcut" >&2
}

main() {
  local action="${1:-help}"
  shift || true
  case "$action" in
    list)
      if [[ "${1:-}" == --json ]]; then status_json | jq -c '[.]'; else render_status; fi
      ;;
    status)
      local requested="$capability_name" json=0
      if [[ $# -gt 0 && "$1" != --json ]]; then requested="$1"; shift; fi
      require_capability "$requested"
      [[ "${1:-}" != --json ]] || json=1
      if [[ "$json" == 1 ]]; then status_json; else render_status; fi
      ;;
    provision) cmd_provision "$@" ;;
    start) require_capability "${1:-}"; cmd_start ;;
    stop) require_capability "${1:-}"; cmd_stop ;;
    run) if [[ "${1:-}" == "$capability_name" ]]; then shift; fi; cmd_run "$@" ;;
    autostart) cmd_autostart "$@" ;;
    boot) cmd_boot ;;
    shortcut) cmd_shortcut "$@" ;;
    help|-h|--help) usage ;;
    *) die "$EX_USAGE" "runtime expects list, status, provision, start, stop, run, autostart, boot, or shortcut" ;;
  esac
}

main "$@"
