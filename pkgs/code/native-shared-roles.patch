+func TestRoutineRoutingUsesServedAvailableAccounts(t *testing.T) {
+	blocks := loadBlocks(fixtureCatalogPath(t))
+	for _, tc := range []struct {
+		name        string
+		connected   map[string]bool
+		serveClaude bool
+		wantLane    string
+		wantTier    string
+	}{
+		{"both available prefer everyday Sonnet", map[string]bool{"A": true, "O": true}, true, "claude-only", "normal"},
+		{"Anthropic only", map[string]bool{"A": true}, true, "claude-only", "normal"},
+		{"OpenAI only uses Sol", map[string]bool{"O": true}, true, "gpt-only", "smart"},
+		{"credentials do not invent a served rung", map[string]bool{"A": true, "O": true}, false, "gpt-only", "smart"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			generated := map[string][]string{}
+			for id, rows := range blocks {
+				if tc.serveClaude || strings.HasPrefix(id, "gpt-only_") {
+					generated[id] = rows
+				}
+			}
+			var routine bool
+			sel := loadSelectionState("", testFacets(), &routine)
+			m := model{sel: sel, routineRouting: routine, facets: testFacets(), generated: generated}
+			m.applyCatalog()
+			m.applyProviderAvailability(tc.connected)
+			if m.sel["lane"] != tc.wantLane || m.sel["model"] != tc.wantTier {
+				t.Fatalf("fresh selection = %v, want %s/%s", m.sel, tc.wantLane, tc.wantTier)
+			}
+			overlay := m.genConfigYAML()
+			want := "anthropic/claude-sonnet-5:medium"
+			if tc.wantLane == "gpt-only" {
+				want = "openai-codex/gpt-5.6-sol:medium"
+			}
+			if !strings.Contains(overlay, "  default: "+want+"\n") {
+				t.Fatalf("fresh overlay does not route %s:\n%s", want, overlay)
+			}
+		})
+	}
+}
