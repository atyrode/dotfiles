+func TestRoutineIntentSurvivesUnrelatedDialSaveAndRestart(t *testing.T) {
+	blocks := loadBlocks(fixtureCatalogPath(t))
+	for _, dial := range []string{"advisor", "thinking"} {
+		t.Run(dial, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "selection.json")
+			handoff := filepath.Join(t.TempDir(), "handoff.json")
+			m := model{
+				sel: defaultSel(), routineRouting: true, facets: testFacets(), generated: blocks,
+				selectionState: path, selectionHandoff: handoff,
+			}
+			m.applyCatalog()
+			m.applyProviderAvailability(map[string]bool{"A": true, "O": true})
+			m = turnDial(t, m, dial)
+			chosen := m.sel[dial]
+			if !m.routineRouting {
+				t.Fatal("an unrelated dial silently froze routine routing")
+			}
+			for _, persisted := range []string{path, handoff} {
+				raw, err := os.ReadFile(persisted)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var stored map[string]string
+				if err := json.Unmarshal(raw, &stored); err != nil {
+					t.Fatal(err)
+				}
+				if stored[selectionRoutingIntentKey] != selectionRoutineIntent {
+					t.Fatalf("routine intent was not saved to %s", persisted)
+				}
+				var routine bool
+				sel := loadSelectionState(persisted, testFacets(), &routine)
+				restarted := model{
+					sel: sel, routineRouting: routine, facets: testFacets(), generated: blocks,
+					avail: availability{ok: true, bucket: map[string]string{"claude-main": "maxed", "codex-main": "ok"}},
+				}
+				restarted.applyCatalog()
+				restarted.applyProviderAvailability(map[string]bool{"A": true, "O": true})
+				if !routine || restarted.sel["lane"] != "gpt-only" || restarted.sel["model"] != "smart" ||
+					restarted.sel[dial] != chosen {
+					t.Fatalf("restart lost routine intent or visible %s choice: %v routine=%t", dial, restarted.sel, routine)
+				}
+			}
+		})
+	}
+}
