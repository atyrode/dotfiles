@@ -0,0 +1,286 @@
+package main
+
+// Metadata refresh changes facts for existing identities, not the operator's
+// ladder or its reachability attestation. It never measures or calls a model.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+type metadataModel struct {
+	Provider      string   `json:"provider"`
+	ID            string   `json:"id"`
+	ContextWindow int      `json:"contextWindow"`
+	Thinking      []string `json:"thinking"`
+	Input         []string `json:"input"`
+	Cost          *struct {
+		Input  *float64 `json:"input"`
+		Output *float64 `json:"output"`
+	} `json:"cost"`
+}
+
+// metadataFields keeps the syntax tree intact, including comments, ordering,
+// folded role notes and unknown authored fields. Ambiguous mappings cannot be
+// safely updated in place.
+func metadataFields(node *yaml.Node, label string) (map[string]*yaml.Node, error) {
+	if node == nil || node.Kind != yaml.MappingNode {
+		return nil, fmt.Errorf("%s must be a mapping", label)
+	}
+	fields := make(map[string]*yaml.Node, len(node.Content)/2)
+	for i := 0; i+1 < len(node.Content); i += 2 {
+		key := node.Content[i]
+		if key.Kind != yaml.ScalarNode || key.Tag != "!!str" {
+			return nil, fmt.Errorf("%s has a non-string key", label)
+		}
+		if _, exists := fields[key.Value]; exists {
+			return nil, fmt.Errorf("%s has duplicate key %q", label, key.Value)
+		}
+		fields[key.Value] = node.Content[i+1]
+	}
+	return fields, nil
+}
+
+func metadataSetScalar(node *yaml.Node, fields map[string]*yaml.Node, key, tag, value string) {
+	if tag == "!!float" && !strings.ContainsAny(value, ".eE") {
+		tag = "!!int"
+	}
+	if field := fields[key]; field != nil {
+		field.Tag, field.Value = tag, value
+		return
+	}
+	field := &yaml.Node{Kind: yaml.ScalarNode, Tag: tag, Value: value}
+	node.Content = append(node.Content, &yaml.Node{Kind: yaml.ScalarNode, Tag: "!!str", Value: key}, field)
+	fields[key] = field
+}
+
+func refreshCatalogMetadata(catalogRaw, modelsRaw []byte) ([]byte, []string, int, error) {
+	var source struct {
+		Models []metadataModel `json:"models"`
+	}
+	if err := json.Unmarshal(modelsRaw, &source); err != nil {
+		return nil, nil, 0, fmt.Errorf("parsing OMP metadata: %w", err)
+	}
+	if len(source.Models) == 0 {
+		return nil, nil, 0, fmt.Errorf("OMP metadata contains no models")
+	}
+	bySelector := make(map[string]metadataModel, len(source.Models))
+	for _, model := range source.Models {
+		if model.Provider == "" || model.ID == "" {
+			return nil, nil, 0, fmt.Errorf("OMP metadata has a model without an exact provider/id")
+		}
+		selector := model.Provider + "/" + model.ID
+		if _, exists := bySelector[selector]; exists {
+			return nil, nil, 0, fmt.Errorf("OMP metadata repeats exact model %s", selector)
+		}
+		bySelector[selector] = model
+	}
+
+	var doc yaml.Node
+	decoder := yaml.NewDecoder(bytes.NewReader(catalogRaw))
+	if err := decoder.Decode(&doc); err != nil {
+		return nil, nil, 0, fmt.Errorf("parsing models file: %w", err)
+	}
+	if len(doc.Content) != 1 {
+		return nil, nil, 0, fmt.Errorf("models file must contain one document")
+	}
+	var extra yaml.Node
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return nil, nil, 0, fmt.Errorf("models file must contain only one document")
+	}
+	root := doc.Content[0]
+	rootFields, err := metadataFields(root, "models file")
+	if err != nil {
+		return nil, nil, 0, err
+	}
+	if field := rootFields["refreshed"]; field != nil && field.Kind != yaml.ScalarNode {
+		return nil, nil, 0, fmt.Errorf("refreshed must be a scalar")
+	}
+	models := rootFields["models"]
+	if _, err := metadataFields(models, "models"); err != nil {
+		return nil, nil, 0, err
+	}
+	var unmatched []string
+	updated := 0
+	for i := 0; i+1 < len(models.Content); i += 2 {
+		key, node := models.Content[i].Value, models.Content[i+1]
+		fields, err := metadataFields(node, "model "+key)
+		if err != nil {
+			return nil, nil, 0, err
+		}
+		id, pool := fields["id"], fields["pool"]
+		if id == nil || pool == nil || id.Kind != yaml.ScalarNode || pool.Kind != yaml.ScalarNode || id.Value == "" {
+			return nil, nil, 0, fmt.Errorf("model %s needs an existing scalar id and pool", key)
+		}
+		provider := providerByPool(pool.Value)
+		if provider == nil {
+			return nil, nil, 0, fmt.Errorf("model %s has unknown pool %q", key, pool.Value)
+		}
+		selector := provider.ID + "/" + id.Value
+		model, found := bySelector[selector]
+		if !found {
+			if provider.Required {
+				return nil, nil, 0, fmt.Errorf("missing exact OMP metadata for %s (%s); models file unchanged", key, selector)
+			}
+			unmatched = append(unmatched, key+" ("+selector+")")
+			continue
+		}
+		if model.Cost == nil || model.Cost.Input == nil || model.Cost.Output == nil ||
+			*model.Cost.Input < 0 || *model.Cost.Output < 0 || model.ContextWindow <= 0 || len(model.Input) == 0 {
+			return nil, nil, 0, fmt.Errorf("incomplete cost/context/input metadata for %s", selector)
+		}
+		seenLevels := make(map[string]bool, len(model.Thinking))
+		knownLevels := 0
+		for _, level := range model.Thinking {
+			if level == "off" {
+				continue
+			}
+			if _, known := thIdx(level); !known || seenLevels[level] {
+				return nil, nil, 0, fmt.Errorf("unsupported or repeated thinking level %q for %s", level, selector)
+			}
+			seenLevels[level] = true
+			knownLevels++
+		}
+		if knownLevels == 0 {
+			return nil, nil, 0, fmt.Errorf("missing supported thinking metadata for %s", selector)
+		}
+		for _, field := range []string{"cost_in", "cost_out", "context", "thinking", "image"} {
+			if value := fields[field]; value != nil && value.Kind != yaml.ScalarNode {
+				return nil, nil, 0, fmt.Errorf("model %s field %s must be a scalar", key, field)
+			}
+		}
+		// Preserve the captured scope: a separately advertised extension must
+		// not replace the authoritative standard contextWindow.
+		metadataSetScalar(node, fields, "cost_in", "!!float", trimFloat(*model.Cost.Input))
+		metadataSetScalar(node, fields, "cost_out", "!!float", trimFloat(*model.Cost.Output))
+		metadataSetScalar(node, fields, "context", "!!int", strconv.Itoa(model.ContextWindow))
+		metadataSetScalar(node, fields, "thinking", "!!str", thinkingField(model.Thinking))
+		image := false
+		for _, modality := range model.Input {
+			image = image || modality == "image"
+		}
+		// Absent image means true to the renderer. Keep that compact convention,
+		// but retain an existing marker (and its comments) when capability changes.
+		if fields["image"] != nil || !image {
+			metadataSetScalar(node, fields, "image", "!!bool", strconv.FormatBool(image))
+		}
+		updated++
+	}
+	if updated == 0 {
+		return nil, nil, 0, fmt.Errorf("no existing catalog identities matched OMP metadata")
+	}
+	// A metadata-only update cannot attest a complete metadata/benchmark run.
+	metadataSetScalar(root, rootFields, "refreshed", "!!null", "null")
+	var out bytes.Buffer
+	encoder := yaml.NewEncoder(&out)
+	encoder.SetIndent(2)
+	if err := encoder.Encode(&doc); err != nil {
+		return nil, nil, 0, err
+	}
+	if err := encoder.Close(); err != nil {
+		return nil, nil, 0, err
+	}
+	return out.Bytes(), unmatched, updated, nil
+}
+
+func runGenerateMetadataRefresh(args []string) int {
+	modelsFile, fromJSON := defaultModelsPath(), ""
+	metadataOnly := false
+	for i := 0; i < len(args); i++ {
+		switch args[i] {
+		case "--metadata-only":
+			metadataOnly = true
+		case "--models-file", "--from-json":
+			flag := args[i]
+			i++
+			if i >= len(args) || args[i] == "" || strings.HasPrefix(args[i], "--") {
+				fmt.Fprintf(os.Stderr, "code generate refresh: %s needs a path\n", flag)
+				return 2
+			}
+			if flag == "--models-file" {
+				modelsFile = args[i]
+			} else {
+				fromJSON = args[i]
+			}
+		case "-h", "--help":
+			fmt.Print(generateHelp)
+			return 0
+		default:
+			fmt.Fprintf(os.Stderr, "code generate refresh: unknown flag %q\n", args[i])
+			return 2
+		}
+	}
+	if !metadataOnly {
+		fmt.Fprintln(os.Stderr, "code generate refresh: --metadata-only is required; no benchmarks or entitlement probes are performed")
+		return 2
+	}
+	fail := func(err error) int {
+		fmt.Fprintf(os.Stderr, "code generate refresh: %v\n", err)
+		return 1
+	}
+	info, err := os.Lstat(modelsFile)
+	if err != nil {
+		return fail(err)
+	}
+	if !info.Mode().IsRegular() {
+		return fail(fmt.Errorf("%s must be an existing regular models file (not a symlink)", modelsFile))
+	}
+	catalogRaw, err := os.ReadFile(modelsFile)
+	if err != nil {
+		return fail(err)
+	}
+	var modelsRaw []byte
+	source := fromJSON
+	if fromJSON != "" {
+		modelsRaw, err = os.ReadFile(fromJSON)
+	} else {
+		// This existing seam only runs `omp models --json`: neither usage nor
+		// bench is consulted, and its listing grants no account entitlement.
+		source = "omp models --json"
+		modelsRaw, err = ompModelsJSON()
+	}
+	if err != nil {
+		return fail(fmt.Errorf("reading %s: %w", source, err))
+	}
+	data, unmatched, updated, err := refreshCatalogMetadata(catalogRaw, modelsRaw)
+	if err != nil {
+		return fail(err)
+	}
+	tmp, err := os.CreateTemp(filepath.Dir(modelsFile), ".code-model-metadata-*")
+	if err != nil {
+		return fail(err)
+	}
+	defer os.Remove(tmp.Name())
+	if err := tmp.Chmod(info.Mode().Perm()); err != nil {
+		tmp.Close()
+		return fail(err)
+	}
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close()
+		return fail(err)
+	}
+	if err := tmp.Sync(); err != nil {
+		tmp.Close()
+		return fail(err)
+	}
+	if err := tmp.Close(); err != nil {
+		return fail(err)
+	}
+	if err := os.Rename(tmp.Name(), modelsFile); err != nil {
+		return fail(err)
+	}
+	fmt.Printf("metadata-only: updated %d existing models in %s from %s; API prices are estimates, not OAuth bills\n", updated, modelsFile, source)
+	fmt.Println("speed/ttft and probed identity attestation unchanged; refreshed: null; no model calls or full benchmark refresh")
+	if len(unmatched) > 0 {
+		fmt.Fprintf(os.Stderr, "unmatched optional models (prior facts preserved): %s\n", strings.Join(unmatched, ", "))
+	}
+	return 0
+}
