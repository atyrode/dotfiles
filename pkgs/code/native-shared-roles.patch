+func TestMetadataRefreshCommandOfflineAndMetadataOnlyLive(t *testing.T) {
+	for _, offline := range []bool{true, false} {
+		t.Run(fmt.Sprintf("offline=%t", offline), func(t *testing.T) {
+			metadataForbidProbes(t)
+			calls := 0
+			oldModels := ompModelsJSON
+			ompModelsJSON = func() ([]byte, error) {
+				calls++
+				return []byte(metadataJSONFixture), nil
+			}
+			t.Cleanup(func() { ompModelsJSON = oldModels })
+			dir := t.TempDir()
+			path := filepath.Join(dir, "models.yml")
+			if err := os.WriteFile(path, []byte(metadataCatalogFixture), 0o640); err != nil {
+				t.Fatal(err)
+			}
+			args := []string{"--metadata-only", "--models-file", path}
+			if offline {
+				jsonPath := filepath.Join(dir, "metadata.json")
+				if err := os.WriteFile(jsonPath, []byte(metadataJSONFixture), 0o600); err != nil {
+					t.Fatal(err)
+				}
+				args = append(args, "--from-json", jsonPath)
+			}
+			if code := runGenerateMetadataRefresh(args); code != 0 {
+				t.Fatalf("refresh exit=%d", code)
+			}
+			wantCalls := 1
+			if offline {
+				wantCalls = 0
+			}
+			if calls != wantCalls {
+				t.Errorf("model metadata calls=%d, want %d", calls, wantCalls)
+			}
+			out, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if metadataDocument(t, out)["models"].(map[string]any)["chosen"].(map[string]any)["cost_in"] != 0.125 {
+				t.Fatal("command did not commit metadata")
+			}
+			info, err := os.Stat(path)
+			if err != nil || info.Mode().Perm() != 0o640 {
+				t.Fatalf("file permissions were not preserved: info=%v err=%v", info, err)
+			}
+		})
+	}
+}
+
+func TestMetadataRefreshFailuresLeaveExistingFileUntouched(t *testing.T) {
+	for _, tc := range []struct {
+		name, catalog, metadata string
+	}{
+		{"missing-exact-id", metadataCatalogFixture, strings.Replace(metadataJSONFixture, `"exact-model"`, `"exact-model-new"`, 1)},
+		{"wrong-provider", metadataCatalogFixture, strings.Replace(metadataJSONFixture, `"anthropic"`, `"openai-codex"`, 1)},
+		{"missing-later-required", metadataCatalogFixture + "  later:\n    id: absent\n    pool: O\n", metadataJSONFixture},
+		{"incomplete-cost", metadataCatalogFixture, strings.Replace(metadataJSONFixture, `"output":4`, `"other":4`, 1)},
+		{"incomplete-input", metadataCatalogFixture, strings.Replace(metadataJSONFixture, `"input":["text","image"]`, `"input":[]`, 1)},
+		{"invalid-json", metadataCatalogFixture, `{`},
+		{"empty-metadata", metadataCatalogFixture, `{"models":[]}`},
+		{"duplicate-id", metadataCatalogFixture, `{"models":[{"provider":"anthropic","id":"exact-model"},{"provider":"anthropic","id":"exact-model"}]}`},
+		{"second-document", metadataCatalogFixture + "---\nkeep: this too\n", metadataJSONFixture},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			metadataForbidProbes(t)
+			dir := t.TempDir()
+			path, jsonPath := filepath.Join(dir, "models.yml"), filepath.Join(dir, "metadata.json")
+			if err := os.WriteFile(path, []byte(tc.catalog), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(jsonPath, []byte(tc.metadata), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			if code := runGenerateMetadataRefresh([]string{"--metadata-only", "--models-file", path, "--from-json", jsonPath}); code != 1 {
+				t.Fatalf("invalid refresh exit=%d, want 1", code)
+			}
+			got, err := os.ReadFile(path)
+			if err != nil || string(got) != tc.catalog {
+				t.Fatalf("failed refresh changed original file: %q err=%v", got, err)
+			}
+			entries, err := os.ReadDir(dir)
+			if err != nil || len(entries) != 2 {
+				t.Fatalf("failed refresh left temporary files: %v err=%v", entries, err)
+			}
+		})
+	}
+}
