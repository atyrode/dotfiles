+func TestMetadataRefreshRequiresExplicitGuardAndExistingFile(t *testing.T) {
+	metadataForbidProbes(t)
+	oldModels := ompModelsJSON
+	ompModelsJSON = func() ([]byte, error) {
+		t.Error("invalid refresh must fail before retrieving metadata")
+		return nil, fmt.Errorf("unexpected metadata request")
+	}
+	t.Cleanup(func() { ompModelsJSON = oldModels })
+	path := filepath.Join(t.TempDir(), "missing.yml")
+	for _, args := range [][]string{
+		{"--models-file", path},
+		{"--metadata-only", "--from-json"},
+		{"--metadata-only", "--models-file", "--from-json", "unused"},
+		{"--metadata-only", "--refresh"},
+	} {
+		if code := runGenerateMetadataRefresh(args); code != 2 {
+			t.Errorf("args=%v exit=%d, want 2", args, code)
+		}
+	}
+	if code := runGenerateMetadataRefresh([]string{"--metadata-only", "--models-file", path}); code != 1 {
+		t.Errorf("missing existing file exit=%d, want 1", code)
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatalf("metadata refresh created a new catalog: %v", err)
+	}
+}
